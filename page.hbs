{{!< default}}
{{!-- Generic pages (About, Privacy…). Article typography, ends at the hearth. --}}

{{> "site-nav"}}

<main id="main" class="generic-page">
    {{#post}}
    <article class="{{post_class}}">

        {{!-- Respect the editor's "Show title and feature image" page setting --}}
        {{#match @page.show_title_and_feature_image}}
        <header class="art-hero">
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p class="lede">{{custom_excerpt}}</p>{{/if}}
        </header>

        {{#if feature_image}}
            <figure class="art-cover">
                <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}
        {{/match}}

        <section class="art-body">
            {{content}}
        </section>

        <footer class="art-foot">
            {{> "subscribe-card" cardClass="subscribe-block-wide"}}
        </footer>

    </article>
    {{/post}}
</main>
