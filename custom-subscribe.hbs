{{!< default}}


{{> "site-nav"}}

<main id="main" class="subscribe-v2">
    <div class="subscribe-v2-left">
        <div class="subscribe-v2-eyebrow">Notes from the work</div>
        <h1>Follow<br><em>the<br>work.</em></h1>
        <p>Occasional updates on large cardamom research, drying methods, field learning, and the development of DHUNERI.</p>
    </div>

    <div class="subscribe-v2-right">
        <div class="subscribe-v2-card">
            <div class="subscribe-v2-card-eyebrow">Email updates</div>
            <h2>Stay close to the<br>research.</h2>
            <p>Leave your email to receive a note when there is something useful and ready to share.</p>

            <div class="subscribe-v2-form-wrap">
                <form data-members-form="subscribe" class="subscribe-v2-form">
                    <input data-members-email type="email" name="email" required placeholder="your@email.com" autocomplete="email" aria-label="Your email">
                    <button type="submit">Subscribe &rarr;</button>
                </form>
                <div class="subscribe-v2-message subscribe-v2-message-success">Success! Please check your inbox to confirm.</div>
                <div class="subscribe-v2-message subscribe-v2-message-error" data-members-error></div>
            </div>

            <div class="subscribe-v2-card-footer">
                Free &middot; Occasional &middot; Unsubscribe anytime
            </div>
        </div>
    </div>

    <footer class="subscribe-v2-footer">
        <div>Dhuneri &middot; Large cardamom research</div>
        <div>No pop-ups &middot; No product reservation</div>
    </footer>
</main>
