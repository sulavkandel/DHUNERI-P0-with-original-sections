{{!< default}}
{{!-- Author archive --}}

{{> "site-nav"}}

<main id="main" class="journal-index">
    {{#author}}
    <section class="jrn-hero">
        <p class="eyebrow">Author</p>
        <h1>{{name}}</h1>
        {{#if bio}}<p class="jrn-lede">{{bio}}</p>{{/if}}
    </section>
    {{/author}}

    <div class="jrn-grid">
        {{#foreach posts}}
            {{> "journal-card"}}
        {{/foreach}}
    </div>

    {{pagination}}

</main>
