{{!-- The hearth card. Reused: home Beat VI (aside), post foot, page ends. Ropani Ink on any cream surface. --}}
<aside class="subscribe-block {{cardClass}}">
    <div class="lg" aria-hidden="true">{{> "logo-limbu"}}</div><span class="sr-only">Dhuneri</span>
    <h4>One letter,<br><em>once a month,</em><br>from a hearth in Taplejung.</h4>
    <p>Field photographs. A recipe. Sometimes a farmer's voice note. No launches, no promo codes.</p>
    <form class="form" data-members-form="subscribe">
        <input data-members-email type="email" name="email" required placeholder="your email" autocomplete="email" aria-label="Your email">
        <button type="submit">Sit by the fire →</button>
        <p class="members-success" aria-live="polite">You're by the fire. Check your inbox to confirm.</p>
        <p class="members-error" data-members-error aria-live="polite"></p>
    </form>
    <div class="promise">Unsubscribe in one click · No third parties</div>
</aside>
