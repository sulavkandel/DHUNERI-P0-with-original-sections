{{!-- Journal grid card. Cover 4:3; no-image posts get the deep-green text-cover from the design. Mobile: 1-col. --}}
<article class="jrn-card {{post_class}} fade-up">
    <a class="cover{{^if feature_image}} cover-noimg{{/if}}" href="{{url}}">
        {{#if primary_tag}}<span class="tag tag-{{primary_tag.slug}}">{{primary_tag.name}}</span>{{/if}}
        {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy">
        {{else}}
            <span class="cover-text" aria-hidden="true">{{title}}</span>
        {{/if}}
    </a>
    <h3><a href="{{url}}">{{title}}</a></h3>
    <p class="meta">By {{primary_author.name}} · {{reading_time}} · {{date format="DD MMM YYYY"}}</p>
</article>
